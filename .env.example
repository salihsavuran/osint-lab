# osint-lab configuration
# Copy to .env and adjust. Every value is optional.

# Where the SQLite database and raw evidence snapshots are stored.
# Default: ~/.local/share/osint-lab
#OSINTLAB_DATA_DIR=./data

# Override the database entirely (e.g. Postgres).
#OSINTLAB_DATABASE_URL=postgresql+psycopg://user:pass@localhost/osintlab

# Identify yourself to public APIs. Several sources (SEC EDGAR especially)
# require a descriptive User-Agent with a contact address.
OSINTLAB_USER_AGENT=osint-lab/0.1 (educational; contact: you@example.org)

# Network behaviour
OSINTLAB_REQUEST_TIMEOUT=20
OSINTLAB_MAX_RETRIES=2

# Refuse to touch the network and serve cached responses only.
# Useful for classroom demos and reproducible tests.
OSINTLAB_OFFLINE=false
